# syntax=docker/dockerfile:1.7

# ---------------------------------------------------------
# Base
# ---------------------------------------------------------
FROM node:24-bookworm-slim AS base

WORKDIR /app

RUN corepack enable \
    && corepack prepare yarn@4.9.4 --activate


# ---------------------------------------------------------
# Install all dependencies
# ---------------------------------------------------------
FROM base AS dependencies

COPY package.json yarn.lock .yarnrc.yml ./

RUN yarn install --immutable


# ---------------------------------------------------------
# Build application inside Docker / CI
# ---------------------------------------------------------
FROM dependencies AS builder

COPY . .

ARG VITE_API_URL
ARG VITE_PUBLIC_BASE_URL
ARG VITE_STRIPE_PUBLISHABLE_KEY
ARG VITE_GA_MEASUREMENT_ID
ARG VITE_REDDIT_PIXEL_ID
ARG VITE_META_PIXEL_ID

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_PUBLIC_BASE_URL=${VITE_PUBLIC_BASE_URL}
ENV VITE_STRIPE_PUBLISHABLE_KEY=${VITE_STRIPE_PUBLISHABLE_KEY}
ENV VITE_GA_MEASUREMENT_ID=${VITE_GA_MEASUREMENT_ID}
ENV VITE_REDDIT_PIXEL_ID=${VITE_REDDIT_PIXEL_ID}
ENV VITE_META_PIXEL_ID=${VITE_META_PIXEL_ID}

RUN yarn build

# Verify Vite output exists.
RUN test -f dist/index.html


# ---------------------------------------------------------
# Production runtime
# ---------------------------------------------------------
FROM node:24-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3004

# Remove package-management tooling from runtime.
RUN rm -rf \
      /usr/local/lib/node_modules/npm \
      /usr/local/bin/npm \
      /usr/local/bin/npx \
      /usr/local/bin/corepack \
      /usr/local/bin/yarn \
      /usr/local/bin/yarnpkg

# Copy only the compiled frontend and Node server.
COPY --from=builder \
     --chown=1000:1000 \
     /app/dist \
     ./dist

COPY --chown=1000:1000 server.mjs ./server.mjs

USER 1000:1000

EXPOSE 3004

CMD ["node", "server.mjs"]
